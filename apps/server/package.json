{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"seed:demo": "tsx src/scripts/seed-demo.ts",
		"test:snippet": "tsx src/scripts/snippet-detect-test.ts",
		"start": "node dist/index.mjs"
	},
	"dependencies": {
		"@custora/api": "workspace:*",
		"@custora/auth": "workspace:*",
		"@custora/db": "workspace:*",
		"@custora/env": "workspace:*",
		"@hono/node-server": "^2.0.12",
		"@hono/trpc-server": "^0.4.2",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@custora/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "catalog:"
	}
}
