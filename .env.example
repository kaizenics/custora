# Copy to .env and fill in. Everything here is read at runtime — nothing is
# baked into the browser bundle, so changing a value is a restart, not a rebuild.

# ─── Database ────────────────────────────────────────────────────────────────
#
# Turso cloud (recommended for anything deployed):
#
#   turso auth login
#   turso db create custora
#   turso db show custora --url          # → libsql://custora-<org>.turso.io
#   turso db tokens create custora       # → the value for DATABASE_AUTH_TOKEN
#
# Then push the schema:  pnpm db:push
DATABASE_URL=libsql://custora-<your-org>.turso.io
DATABASE_AUTH_TOKEN=

# Local SQLite instead — no Turso account, no network. Relative paths resolve
# from the repo root regardless of which directory you run a command in.
#
#   DATABASE_URL=file:local.db
#   DATABASE_AUTH_TOKEN=unused-for-local-file
#
# In a container, point this at a mounted volume or the database is wiped on
# every redeploy:
#
#   DATABASE_URL=file:/app/data/custora.db

# ─── Auth ────────────────────────────────────────────────────────────────────
#
# Must be at least 32 characters. Generate one with:
#
#   openssl rand -base64 32
#
# Changing it invalidates every existing session.
BETTER_AUTH_SECRET=

# The app's own public origin — scheme and host, no trailing slash. Used as both
# the auth base URL and the trusted origin, so a mismatch shows up as sign-in
# silently failing rather than as a useful error.
#
#   local dev:   http://localhost:3100
#   deployed:    https://app.yourdomain.com
BETTER_AUTH_URL=http://localhost:3100

# Registration is closed in production unless this is set. Open it just long
# enough to create the accounts you need, then remove it and redeploy —
# otherwise anyone who reaches /login can read every contact and deal you have.
# ALLOW_SIGNUP=true

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# Port the production server listens on (pnpm start). The dev server is fixed at
# 3100 by vite.config.ts. Defaults to 3000 when unset.
# PORT=3000
